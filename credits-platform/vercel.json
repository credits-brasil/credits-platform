{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/visualizar-consulta",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://controle-sistema.creditsbrasil.com.br"
        }
      ]
    }
  ]
}
